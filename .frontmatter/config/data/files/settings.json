{
    "$schema": "https://frontmatter.codes/config/data.files.schema.json",
    "id": "settings",
    "title": "Settings",
    "file": "[[workspace]]/content/_data/settings.json",
    "fileType": "json",
    "singleEntry": true,
    "schema": {
      "title": "Settings",
      "type": "object",
      "required": [],
      "properties": {
        "theme": {
          "type": "string",
          "title": "Theme",
          "default": "default"
        },
        "themeColorLight": {
          "type": "string",
          "title": "Theme Color (Light)"
        },
        "themeColorDark": {
          "type": "string",
          "title": "Theme Color (Dark)"
        },
        "cdn": {
          "type": "boolean",
          "title": "Enable image CDN?"
        },
        "author": {
          "type": "object",
          "title": "Author",
          "properties": {
            "name": {
              "type": "string",
              "title": "Name"
            },
            "email": {
              "type": "string",
              "title": "Email"
            },
            "url": {
              "type": "string",
              "title": "URL",
              "default": "https://"
            },
            "location": {
              "type": "string",
              "title": "Location",
              "default": ""
            },
            "fediverseProfile": {
              "type": "string",
              "title": "Fediverse URL",
              "default": "https://mastodon.social/@person"
            },
            "fediverseUsername": {
              "type": "string",
              "title": "Fediverse Username",
              "default": "@person@mastodon.social"
            },
            "githubProfile": {
              "type": "string",
              "title": "GitHub URL",
              "default": "https://github.com/person"
            }
          }
        },
        "meta": {
          "type": "object",
          "title": "Meta",
          "properties": {
            "separator": {
              "type": "string",
              "title": "Separator"
            },
            "opengraphDefaultImage": {
              "type": "string",
              "title": "Default Opengraph Image",
              "default": "/assets/img/og/opengraph-default.png"
            }
          }
        },
        "seo": {
          "type": "object",
          "title": "SEO",
          "properties": {
            "defaultChangeFrequency": {
              "type": "string",
              "title": "Default Change Frequency",
              "default": "monthly"
            },
            "defaultPriority": {
              "title": "Default Sitemap Priority",
              "type": "number",
              "default": 0.7,
              "numberOptions": {
                "isDecimal": true,
                "min": 0.1,
                "max": 1,
                "step": 0.1
              }
            }
          }
        },
        "manifest": {
          "type": "object",
          "title": "Web Manifest (https://web.dev/add-manifest/#create)",
          "properties": {
            "themeColor": {
              "type": "string",
              "title": "Theme Color"
            },
            "backgroundColor": {
              "type": "string",
              "title": "Background Color"
            },
            "display": {
              "type": "string",
              "title": "Display (fullscreen, standalone, minimal-ui, browser)",
              "default": "minimal-ui"
            },
            "orientation": {
              "type": "string",
              "title": "Orientation",
              "default": "portrait-primary"
            },
            "categories": {
              "type": "array",
              "title": "Categories (https://github.com/w3c/manifest/wiki/Categories)",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "toc": {
          "type": "array",
          "title": "Table of Contents Levels",
          "default": [2, 3],
          "items": {
            "type": "number",
            "enum": [1, 2, 3, 4, 5, 6]
          }
        },
        "templates": {
          "type": "array",
          "title": "Virtual Templates",
          "default": ["robots", "sitemap", "manifest", "blogroll", "search", "feed"],
          "items": {
            "type": "string",
            "enum": ["robots", "sitemap", "manifest", "blogroll", "search", "feed"]
          }
        },
        "plugins": {
          "type": "array",
          "title": "Optional Plugins",
          "default": ["rss", "render", "anchors", "syntaxhighlight", "embeds"],
          "items": {
            "type": "string",
            "enum": ["rss", "render", "anchors", "syntaxhighlight", "embeds"]
          }
        },
        "norobots": {
          "type": "boolean",
          "title": "Discourage AI crawlers",
          "description": "Include the ai-robots-txt blocklist in production robots.txt",
          "default": true
        },
        "images": {
          "type": "object",
          "title": "Image Settings",
          "properties": {
            "formats": {
              "type": "array",
              "title": "Image Formats",
              "description": "Output image formats (use 'auto' for browser detection)",
              "default": ["avif", "webp", "svg", "auto"],
              "items": {
                "type": "string",
                "enum": ["avif", "webp", "svg", "jpeg", "png", "auto"]
              }
            }
          }
        },
        "embeds": {
          "type": "object",
          "title": "Embed Settings",
          "properties": {
            "use": {
              "type": "array",
              "title": "Embeds",
              "description": "Third-party embeds to enable",
              "default": ["twitter", "youtube", "vimeo", "instagram", "tiktok", "openstreetmap", "ted", "soundcloud", "spotify"],
              "items": {
                "type": "string",
                "enum": ["twitter", "youtube", "vimeo", "instagram", "tiktok", "openstreetmap", "ted", "soundcloud", "spotify"]
              }
            }
          }
        }
      }
    }
  }